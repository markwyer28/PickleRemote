<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="#07111F">
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9DB0C9" android:textSize="16sp" android:gravity="center"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<LinearLayout android:id="@+id/teamABox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#11233A"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEAM A" android:textColor="#FFFFFF" android:textSize="28sp"/><TextView android:id="@+id/scoreA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="110sp"/><TextView android:id="@+id/serveA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#24D18A" android:textSize="20sp"/></LinearLayout>
<Space android:layout_width="12dp" android:layout_height="match_parent"/>
<LinearLayout android:id="@+id/teamBBox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#11233A"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEAM B" android:textColor="#FFFFFF" android:textSize="28sp"/><TextView android:id="@+id/scoreB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="110sp"/><TextView android:id="@+id/serveB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#24D18A" android:textSize="20sp"/></LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<Button android:id="@+id/undo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="UNDO"/><Button android:id="@+id/switchServer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SERVER"/><Button android:id="@+id/switchTeam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SWITCH TEAM"/><Button android:id="@+id/reset" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RESET"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Remote: single = point • double = server • hold = switch team" android:textColor="#7F93AE" android:gravity="center"/>
</LinearLayout>